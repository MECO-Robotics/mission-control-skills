#!/usr/bin/env node
const cli = require("../src/cli");
const result = cli.commandValidateContextBudget(process.argv.slice(2));
if (result.valid) {
  console.log("valid");
  process.exit(0);
}
console.log("invalid");
for (const failure of result.failures) {
  console.log(failure);
}
process.exit(1);


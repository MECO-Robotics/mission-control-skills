{
  "profiles": {
    "architect": {
      "name": "architect",
      "max_score": 100,
      "pass_threshold": 72,
      "weights": {
        "decomposition_quality": 0.28,
        "dependency_identification": 0.27,
        "repository_ownership_accuracy": 0.22,
        "task_planning_quality": 0.23
      }
    },
    "coder": {
      "name": "coder",
      "max_score": 100,
      "pass_threshold": 74,
      "weights": {
        "implementation_correctness": 0.33,
        "test_coverage_impact": 0.23,
        "issue_completion": 0.22,
        "architecture_adherence": 0.22
      }
    },
    "reviewer": {
      "name": "reviewer",
      "max_score": 100,
      "pass_threshold": 70,
      "weights": {
        "finding_quality": 0.28,
        "false_positive_rate": 0.22,
        "severity_accuracy": 0.25,
        "missed_issue_rate": 0.25
      }
    },
    "maintainer": {
      "name": "maintainer",
      "max_score": 100,
      "pass_threshold": 72,
      "weights": {
        "merge_readiness": 0.32,
        "dependency_awareness": 0.23,
        "release_readiness": 0.23,
        "repository_health": 0.22
      }
    },
    "retrieval": {
      "name": "retrieval",
      "max_score": 100,
      "pass_threshold": 70,
      "weights": {
        "context_relevance": 0.3,
        "missing_context_penalty": 0.25,
        "ranking_quality": 0.25,
        "architecture_awareness": 0.2
      }
    },
    "workflow": {
      "name": "workflow",
      "max_score": 100,
      "pass_threshold": 76,
      "weights": {
        "issue_to_pr_traceability": 0.35,
        "handoff_quality": 0.33,
        "review_artifact_presence": 0.32
      }
    }
  },
  "providers": {
    "promptfoo": {
      "enabled": true,
      "binary": "promptfoo",
      "command": "promptfoo",
      "timeoutMs": 120000,
      "jsonArg": "--format=json"
    }
  },
  "defaults": {
    "provider": "promptfoo",
    "result_dir": "evaluations",
    "result_file": "results.json",
    "summary_file": "scorecard.md",
    "profile": "coder",
    "max_score": 100,
    "repository_root": ".",
    "regression": {
      "max_drop_points": 10,
      "max_drop_percent": 12
    }
  },
  "integration": {
    "require_graphify_for_retrieval": false,
    "require_repository_intelligence": true,
    "require_static_analysis_for_reviewer": false
  }
}
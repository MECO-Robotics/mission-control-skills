#!/usr/bin/env node
const engine = require("../src/engine");

function parse(argv) {
  const out = {};
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === "--repository-root") { out.repositoryRoot = argv[i + 1]; i += 1; continue; }
    if (arg === "--index-root") { out.outputDir = argv[i + 1]; i += 1; continue; }
    if (arg === "--index-file") { out.indexFile = argv[i + 1]; i += 1; continue; }
    if (arg === "--config") { out.configPath = argv[i + 1]; i += 1; continue; }
    if (arg === "--profile") { out.profile = argv[i + 1]; i += 1; continue; }
    if (arg === "--qdrant") { out.qdrant = true; continue; }
  }
  return out;
}

const args = parse(process.argv.slice(2));
const result = engine.buildSemanticIndex({
  repositoryRoot: args.repositoryRoot || process.cwd(),
  outputDir: args.outputDir,
  indexFile: args.indexFile,
  configPath: args.configPath,
  profile: args.profile || "coder",
});
console.log(JSON.stringify(result, null, 2));

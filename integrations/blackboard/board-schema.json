{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "blackboard-board",
  "type": "object",
  "additionalProperties": false,
  "required": ["boards", "entries"],
  "properties": {
    "boards": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/board"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/entry"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "definitions": {
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "status", "created_at", "updated_at", "history", "entries"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["task-board", "repository-board", "review-board", "release-board", "architecture-board"] },
        "repository": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "archived", "locked"] },
        "related_tasks": { "type": "array", "items": { "type": "string" } },
        "metadata": { "type": "object" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "history": { "type": "array", "items": { "type": "object" } },
        "entries": { "type": "array", "items": { "type": "string" } }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "board_id",
        "entry_type",
        "status",
        "author_role",
        "summary",
        "details",
        "created_at",
        "updated_at",
        "history"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "board_id": { "type": "string", "minLength": 1 },
        "entry_type": {
          "type": "string",
          "enum": ["hypothesis", "plan", "finding", "question", "decision", "risk", "dependency", "note", "action_item"]
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved", "rejected", "superseded"]
        },
        "author_role": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "details": { "type": "string" },
        "related_tasks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "related_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "related_symbols": {
          "type": "array",
          "items": { "type": "string" }
        },
        "related_findings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metadata": { "type": "object" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "history": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}

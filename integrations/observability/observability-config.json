{
  "defaults": {
    "provider": "local",
    "send_remote_by_default": false,
    "trace_dir": "observability/traces",
    "include_secret_redaction": true
  },
  "providers": {
    "langfuse": {
      "enabled": false,
      "sendRemote": false,
      "public_key_env": "LANGFUSE_PUBLIC_KEY",
      "secret_key_env": "LANGFUSE_SECRET_KEY",
      "endpoint_env": "LANGFUSE_HOST"
    }
  }
}

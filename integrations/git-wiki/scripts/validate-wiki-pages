#!/usr/bin/env node

const {
  parseArgs,
  loadConfig,
  loadMissionState,
  validateWikiPages,
} = require("./_wiki-lib");

const args = parseArgs(process.argv.slice(2));
if (args.flags.help) {
  console.log("Usage: node validate-wiki-pages [--output-dir wiki]");
  process.exit(0);
}

const config = loadConfig();
if (args.flags["output-dir"]) {
  config.output_dir = args.flags["output-dir"];
}

const state = loadMissionState();
const result = validateWikiPages(config, state);
if (result.errors.length > 0) {
  for (const error of result.errors) {
    console.error(`error: ${error}`);
  }
  console.error(`validation failed with ${result.errors.length} error(s)`);
  process.exit(1);
}

console.log("wiki validation passed");

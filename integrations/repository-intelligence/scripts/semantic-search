#!/usr/bin/env node
const engine = require("../src/engine");

function parse(argv) {
  const out = {};
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === "--query") {
      out.query = argv[i + 1];
      i += 1;
    } else if (arg === "--profile") {
      out.profile = argv[i + 1];
      i += 1;
    } else if (arg === "--limit") {
      out.limit = argv[i + 1];
      i += 1;
    } else if (arg === "--repo" || arg === "--repository-root") {
      out.repositoryRoot = argv[i + 1];
      i += 1;
    } else if (arg === "--vector") {
      out.preferVector = true;
    } else if (!out.query) {
      out.query = arg;
    }
  }
  return out;
}

const args = parse(process.argv.slice(2));
if (!args.query) {
  throw new Error("semantic-search requires a query.");
}
const result = engine.semanticSearch({
  query: args.query,
  profile: args.profile,
  limit: args.limit,
  repositoryRoot: args.repositoryRoot,
  preferVector: args.preferVector,
});
console.log(JSON.stringify(result, null, 2));

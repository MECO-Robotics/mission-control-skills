{
  "profiles": {
    "architect": {
      "name": "architect",
      "include": {
        "directories": ["AGENTS.md", "docs", "architecture", ".github", "contracts"],
        "files": ["architecture-wiki.md", "decision-log.json", "global-issues.json"]
      },
      "exclude": {
        "directories": ["dist", "build", "coverage", "node_modules", ".git", "tmp"]
      },
      "resultLimit": 50,
      "documentation": {
        "include": true
      },
      "tests": {
        "include": false
      }
    },
    "coder": {
      "name": "coder",
      "include": {
        "directories": ["src", "lib", "packages", "apps", "services"],
        "files": []
      },
      "exclude": {
        "directories": ["dist", "build", "coverage", "node_modules", ".git", "tmp"]
      },
      "resultLimit": 50,
      "documentation": {
        "include": false
      },
      "tests": {
        "include": true
      }
    },
    "reviewer": {
      "name": "reviewer",
      "include": {
        "directories": ["src", "test", "tests", "__tests__"],
        "files": []
      },
      "exclude": {
        "directories": ["dist", "build", "coverage", "node_modules", ".git", "tmp"]
      },
      "resultLimit": 60,
      "documentation": {
        "include": true
      },
      "tests": {
        "include": true
      },
      "priorities": ["changed_files", "related_tests", "prior_bugs"]
    },
    "maintainer": {
      "name": "maintainer",
      "include": {
        "directories": ["", ".github", "scripts", "tools", "docs"],
        "files": ["dependency-map.json", "repo-registry.json", "global-issues.json"]
      },
      "exclude": {
        "directories": ["dist", "build", "coverage", "node_modules", ".git", "tmp"]
      },
      "resultLimit": 60,
      "documentation": {
        "include": true
      },
      "tests": {
        "include": true
      }
    }
  }
}

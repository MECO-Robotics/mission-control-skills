#!/usr/bin/env node

const fs = require("node:fs");
const path = require("node:path");

const ROOT = process.cwd();
const DECISIONS_PATH = path.join(ROOT, ".mission-control/cross-repo-decisions.md");

function parseArgs(argv) {
  const args = {};
  for (let i = 2; i < argv.length; i++) {
    const token = argv[i];
    if (!token.startsWith("--")) continue;
    const key = token.slice(2);
    const next = argv[i + 1];
    if (!next || next.startsWith("--")) {
      args[key] = true;
      continue;
    }
    args[key] = next;
    i++;
  }
  return args;
}

const args = parseArgs(process.argv);
const required = ["task", "decision", "rationale"];
for (const key of required) {
  if (!args[key]) {
    console.error(`--${key} is required`);
    process.exit(1);
  }
}

const timestamp = new Date().toISOString();
const repos = args.repos ? args.repos.split(",").map((r) => r.trim()).filter(Boolean) : [];
const followUp = args.follow_up || "";
const note = [
  `## ${timestamp}`,
  `- **Task ID:** ${args.task}`,
  `- **Decision:** ${args.decision}`,
  `- **Rationale:** ${args.rationale}`,
  `- **Affected repositories:** ${repos.length ? repos.join(", ") : "N/A"}`,
  `- **Follow-up actions:** ${followUp || "none"}`,
  "",
].join("\n");

fs.appendFileSync(DECISIONS_PATH, `${note}\n`, "utf8");
console.log("decision logged");
